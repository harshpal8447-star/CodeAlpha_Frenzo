# ==============================================================================
# FRENZO BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to .env and configure local values.
# NEVER commit the actual .env file with production secrets to version control.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000

# Client & CORS Whitelist (comma-separated origins)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5000,http://127.0.0.1:5000,http://localhost:8080,http://127.0.0.1:8080

# API Versioning
API_VERSION=v1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ==============================================================================
# DATABASE CONFIGURATION (PostgreSQL 16 on Supabase — Phase 2)
# ==============================================================================
# Copy exact values from your Supabase Dashboard: Settings -> Database
# 
# 1. Runtime API Connection (Supavisor Transaction Pooler, Port 6543):
#    Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require

# 2. DDL Migrations Connection (Direct / Session Mode, Port 5432):
#    Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_DIRECT_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Connection Pool Settings
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ==============================================================================
# SECURITY & AUTHENTICATION SECRETS (Phase 2)
# ==============================================================================
# Cryptographic secrets: generate via `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
CSRF_SECRET=your_32_byte_hex_csrf_secret_minimum_64_characters_placeholder
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_placeholder
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_placeholder
COOKIE_SECRET=your_cookie_signing_secret_min_32_characters_placeholder
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==============================================================================
# STORAGE & AI CONFIGURATIONS (DEFERRED TO LATER PHASES)
# ==============================================================================
# Supabase Storage Configuration (Phase 3)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Companion Engine Configuration (Phase 6)
# AI_PROVIDER=none
# GEMINI_API_KEY=
