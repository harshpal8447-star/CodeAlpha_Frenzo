{
  "name": "frenzo-backend",
  "version": "1.0.0",
  "description": "Frenzo Social Platform REST API",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
